# ==========================================
# BloodLink Environment Variables (Example)
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Real Database Configuration (Docker Mongo or Mongo Atlas)
MONGODB_URI=mongodb://localhost:27017/bloodlink

# Authentication Secrets (Generate secure random string in production)
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Client Configuration
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
