{
  "name": "bloodlink-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue.bold,magenta.bold\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "type-check": "npm run type-check --workspace=server && npm run type-check --workspace=client",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "seed": "npm run seed --workspace=server",
    "test": "npm run test --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
